# Copy to backend/.env and adjust. Everything here has a sensible default.

# --- Which models to use --------------------------------------------------
# "ollama" = fully local, no API key. "openai" = api.openai.com.
LLM_PROVIDER=ollama

# Only needed for LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional: any other OpenAI-compatible server (LM Studio, vLLM, ...)
OPENAI_BASE_URL=

# Only used for LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Leave empty to use the defaults for the provider:
#   ollama: qwen2.5:7b + nomic-embed-text (768 dims)
#   openai: gpt-4o-mini + text-embedding-3-large (3072 dims)
# CHAT_MODEL=
# EMBEDDING_MODEL=
# VECTOR_DIMENSIONS=

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. A Supabase connection string works too.
DATABASE_URL=postgresql://deepscholar:deepscholar@localhost:5432/deepscholar

# Wipe all papers and logs on every restart (old demo behaviour)
RESET_ON_STARTUP=false

# --- Misc ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./data/uploads
